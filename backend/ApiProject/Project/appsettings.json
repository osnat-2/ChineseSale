{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "JWTSettings": {
    "Issuer": "ChineseSaleApi",
    "Audience": "RegisteredUsersAndDonors",
    "ExpirationInMinutes": 90
  },
  "AllowedHosts": "localhost;127.0.0.1",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=ChineseSale;Trusted_Connection=True;TrustServerCertificate=True;"
  }
}